#!/bin/bash
# GiSquare OS - preparazione del desktop al primo accesso di ogni utente
set -u
FLAG="$HOME/.config/gisquare-os/desktop-pronto"
# Le versioni di prova copiavano sul desktop anche il collegamento nascosto per i file .gsq
# (GiSquare Circuiti compariva due volte): lo togliamo
rm -f "$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")/gisquare-circuiti-file.desktop"
[ -f "$FLAG" ] && exit 0
SFONDO=/usr/share/gisquare-os/sfondo.png

# 1. Sfondo: aspetta che xfdesktop abbia creato le sue impostazioni, poi applica lo sfondo
for _ in $(seq 1 30); do
    xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -q 'last-image$' && break
    sleep 1
done
xfconf-query -c xfce4-desktop -l 2>/dev/null | grep 'last-image$' | while read -r p; do
    xfconf-query -c xfce4-desktop -p "$p" -s "$SFONDO"
    xfconf-query -c xfce4-desktop -p "${p%last-image}image-style" -n -t int -s 5 2>/dev/null \
        || xfconf-query -c xfce4-desktop -p "${p%last-image}image-style" -s 5
done

# 2. Collegamenti sul desktop
xdg-user-dirs-update 2>/dev/null || true
DESKTOP=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
mkdir -p "$DESKTOP"
collegamenti=(/usr/share/applications/gisquare-guida.desktop
              /usr/share/applications/gisquare-recupero.desktop)
[ -d /run/live ] && collegamenti=(/usr/share/applications/gisquare-installa.desktop "${collegamenti[@]}")
[ -f /usr/share/applications/gisquare-circuiti.desktop ] \
    && collegamenti+=(/usr/share/applications/gisquare-circuiti.desktop)
for f in "${collegamenti[@]}"; do
    [ -f "$f" ] || continue
    dest="$DESKTOP/$(basename "$f")"
    cp -f "$f" "$dest"
    chmod +x "$dest"
    # segna il collegamento come "fidato" per XFCE (niente avviso al primo clic)
    gio set -t string "$dest" metadata::xfce-exe-checksum "$(sha256sum "$dest" | cut -d' ' -f1)" 2>/dev/null || true
done

mkdir -p "$(dirname "$FLAG")"
touch "$FLAG"
